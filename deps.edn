{:paths ["src"]
 ;; langgraph-clj brings langchain-clj transitively (both zero-/single-dep,
 ;; all .cljc -> portable to JVM / SCI / ClojureScript / GraalVM/WASM). It
 ;; lives in the kotoba-lang org of this workspace. This repo is standalone
 ;; (forkable outside the workspace); the :local/root paths only resolve
 ;; inside the monorepo checkout -- a standalone fork should override them
 ;; with git coordinates. `civilworks.store` uses `langchain-store.core`
 ;; for the shared EDN-blob codec / identity-schema / entity field-spec
 ;; machinery (ADR-2607141600) instead of hand-rolling it.
 ;;
 ;; This actor is COORDINATION-ONLY (every proposal effect is `:propose`)
 ;; -- it deliberately has NO dependency on `kotoba-lang/robotics` or
 ;; `kotoba-lang/physics-2d`: it never simulates or dispatches
 ;; heavy-equipment/crew actions, only proposes, schedules, flags and logs,
 ;; all governor- and human-gated (see README). Per this repo's mandate
 ;; (cljs-first / fully portable `.cljc`, no JVM interop -- see
 ;; superproject CLAUDE.md `.cljc`/`.kotoba` runtime priority note),
 ;; `civilworks.notify`'s real transport is a plain-function INJECTION
 ;; seam (`fn-notifier`) -- unlike some earlier sibling actors' notify.cljc,
 ;; this repo does NOT embed a `java.net.http`/platform HTTP client itself.
 ;; jp-go-digital-design-system (DADS) is this workspace's BASE design
 ;; system (superproject CLAUDE.md, 2026-08-05). `civilworks.render-html`
 ;; styles the build-time operator console with `jp-go-dds.skin/dds+skin`
 ;; -- the compatibility skin that restyles plain semantic markup with
 ;; DADS tokens without inventing a second design system or writing raw
 ;; hex colours. It is a git dep (not :local/root) so a standalone fork
 ;; outside the monorepo can still regenerate the console.
 :deps {io.github.com-junkawasaki/langgraph-clj
        {:local/root "../../kotoba-lang/langgraph"}
        io.github.kotoba-lang/langchain-store
        {:local/root "../../kotoba-lang/langchain-store"}
        io.github.kotoba-lang/jp-go-digital-design-system
        {:git/url "https://github.com/kotoba-lang/jp-go-digital-design-system"
         :git/sha "83db99546eabc53613ae826ea41d1533a3c574af"}}
 :aliases
 {;; This alias held an :override-deps entry for the retired coordinate
  ;; io.github.com-junkawasaki/langchain-clj. langgraph declares the same
  ;; library as io.github.kotoba-lang/langchain, so the entry matched no
  ;; node in the resolved tree and never reached the classpath -- verified
  ;; with `clojure -Stree`/-Spath, unchanged before and after removal.
  :dev {}
  ;; clojure -M:dev:run  -> drive the demo through one OperationActor
  :run {:main-opts ["-m" "civilworks.sim"]}
  ;; clojure -M:dev:render-html [out-file] -> regenerate
  ;; docs/samples/operator-console.html through the REAL actor stack
  ;; (flagship checklist item 2). Refuses to write when the run produces
  ;; zero :governor-hold ledger facts -- see civilworks.render-html.
  :render-html {:main-opts ["-m" "civilworks.render-html"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; static analysis -- clj-kondo from deps (no binary), errors fail CI.
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main"
                        "--lint" "src" "test"
                        "--fail-level" "error"]}}}
